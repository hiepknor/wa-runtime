[Unit]
Description=Record aggregate WA Runtime storage observations
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/wa-runtime/scripts/runtime-storage-observation.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/wa-runtime/shared
