{
  "name": "automation-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane and durable automation runtime for WA Studio",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.build.json",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:scheduler": "tsx watch src/entrypoints/scheduler.ts",
    "dev:webhook-proxy": "tsx scripts/webhook-proxy.ts",
    "start:api": "node dist/src/entrypoints/api.js",
    "start:worker": "node dist/src/entrypoints/worker.js",
    "start:scheduler": "node dist/src/entrypoints/scheduler.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "contract:generate": "npm run build --silent && node dist/scripts/generate-runtime-contract.js",
    "contract:check": "npm run contract:generate && git diff --exit-code -- contracts/runtime/v1/openapi.json",
    "load-test:dry-run": "tsx scripts/load-test-dry-run.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build --silent && vitest run --config vitest.integration.config.ts",
    "test:group-members": "npm run build --silent && vitest run --config vitest.group-members.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "check:all": "npm run check && npm run test:integration"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-yaml": "5.2.3"
  }
}
