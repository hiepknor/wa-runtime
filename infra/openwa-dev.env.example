NODE_ENV=development
OPENWA_IMAGE=ghcr.io/rmyndharis/openwa:0.15.0
API_MASTER_KEY=replace-with-a-long-local-admin-key

DATABASE_NAME=openwa_dev
DATABASE_USERNAME=openwa_dev
DATABASE_PASSWORD=replace-with-a-long-postgres-password
REDIS_PASSWORD=replace-with-a-long-redis-password
S3_ACCESS_KEY_ID=openwa_dev
S3_SECRET_ACCESS_KEY=replace-with-a-long-minio-secret

OPENWA_DEV_NODE_ID=openwa-local-dev
OPENWA_DEV_API_PORT=2785
